{
  "name": "sweetgrass",
  "version": "0.3.1",
  "scripts": {
    "dev": "next dev -p 3007",
    "build": "next build",
    "start": "next start -p 3007",
    "lint": "eslint src npm --ext .js,.jsx,.ts,.tsx --ignore-pattern out --ignore-pattern .next --ignore-pattern server/target",
    "typecheck": "tsc --noEmit",
    "server:dev": "cd server && cargo run",
    "server:build": "cd server && cargo build --release",
    "dev:full": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "prepare": "bash scripts/install-hooks.sh",
    "lint:fix": "eslint src npm --ext .js,.jsx,.ts,.tsx --fix --ignore-pattern out --ignore-pattern .next --ignore-pattern server/target",
    "precommit:full": "npm run lint && npm run typecheck && npm run build && cd server && cargo clippy -- -D warnings && cargo test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "agentation": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.42.0",
    "next": "^15.5.20",
    "ogl": "^1.0.11",
    "radix-ui": "^1.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "rehype-highlight": "^7.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.2",
    "concurrently": "^8.2.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.20",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
